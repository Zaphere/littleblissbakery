# Shared backup sync — server configuration
#
# The app works entirely offline with no configuration at all. These values are
# only needed for the "Shared backup" feature, where the tablet, phone and office
# laptop share one copy of the bakery data.
#
# Without these, the sync endpoint returns 503 and the app carries on as a
# local-only device: history, restore and file backups all keep working.

# --- Option A: Upstash Redis (recommended) ----------------------------------
# Create a database at console.upstash.io. Both values are on the first page.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Option B: Vercel KV -----------------------------------------------------
# Create a KV store in the Vercel dashboard → Storage. Either set works; the
# endpoint reads whichever pair is present.
KV_REST_API_URL=
KV_REST_API_TOKEN=
